{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "docker-compose",
    "github-actions"
  ],
  "dependencyDashboard": false,
  "separateMinorPatch": true,
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)common-services\\.yml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/docker-publish\\.yml$/"
      ],
      "matchStrings": [
        "WORDPRESS_BASE_IMAGE: wordpress:(?<currentValue>\\d+\\.\\d+\\.\\d+-php\\d+\\.\\d+-fpm)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "wordpress",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "wordpress"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "ghcr.io/librecodecoop/wordpress-docker"
      ],
      "enabled": false
    }
  ]
}
